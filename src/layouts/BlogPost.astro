---
import type { MarkdownHeading } from 'astro';
import type { CollectionEntry } from 'astro:content';
import FormattedDate from '../components/FormattedDate.astro';
import TableOfContents from '../components/TableOfContents.astro';
import { SITE_TITLE } from '../consts';
import { sitePath } from '../paths';
import SiteLayout from './SiteLayout.astro';

type Props = CollectionEntry<'blog'>['data'] & { headings: MarkdownHeading[] };

const { title, description, pubDate, updatedDate, heroImage, tags, headings } = Astro.props;
const toc = headings.filter(({ depth }) => depth === 2 || depth === 3);
---

<SiteLayout title={`${title} · ${SITE_TITLE}`} {description} image={heroImage}>
	<article>
		<header class="article-heading">
			<a class="back-link" href={sitePath('posts/')}><span aria-hidden="true">←</span> 전체 글</a>
			<h1>{title}</h1>
			<p>{description}</p>
			<div class="article-meta">
				<FormattedDate date={pubDate} />
				{updatedDate && <span>수정 <FormattedDate date={updatedDate} /></span>}
				{tags.length > 0 && (
					<ul class="tags" aria-label="태그">{tags.map((tag) => <li>{tag}</li>)}</ul>
				)}
			</div>
		</header>
		<div class:list={['article-grid', { 'has-toc': toc.length > 0 }]}>
			{toc.length > 0 && (
				<>
					<details class="toc-mobile">
						<summary>목차</summary>
						<nav aria-label="글 목차"><TableOfContents headings={toc} /></nav>
					</details>
					<aside class="toc-desktop">
						<nav aria-label="글 목차"><h2>목차</h2><TableOfContents headings={toc} /></nav>
					</aside>
				</>
			)}
			<div class="prose">
				<slot />
			</div>
		</div>
	</article>
</SiteLayout>
