---
import PostList from '../components/PostList.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import SiteLayout from '../layouts/SiteLayout.astro';
import { sitePath } from '../paths';
import { getPosts } from '../posts';

const posts = (await getPosts()).slice(0, 5);
---

<SiteLayout title={`${SITE_TITLE} 기술 블로그`} description={SITE_DESCRIPTION}>
	<section class="home-intro">
		<h1>{SITE_TITLE}<span aria-hidden="true">.</span></h1>
		<p>{SITE_DESCRIPTION}</p>
	</section>
	<section aria-labelledby="recent-posts">
		<div class="section-heading">
			<h2 id="recent-posts">최근 글</h2>
			<a href={sitePath('posts/')}>전체 글 <span aria-hidden="true">→</span></a>
		</div>
		<PostList {posts} headingLevel="h3" />
	</section>
</SiteLayout>
