---
import PostList from '../../components/PostList.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { getPosts } from '../../posts';

const posts = await getPosts();
const tags = [...new Set(posts.flatMap((post) => post.data.tags))].sort((a, b) =>
	a.localeCompare(b, 'ko'),
);
---

<SiteLayout title={`글 · ${SITE_TITLE}`} description={SITE_DESCRIPTION}>
	<header class="page-heading">
		<h1>글</h1>
	</header>
	<section data-post-archive aria-label="전체 글">
		{tags.length > 0 && (
			<div class="tag-filter" role="group" aria-label="태그 필터" hidden>
				<button type="button" data-tag="" aria-pressed="true">전체</button>
				{tags.map((tag) => (
					<button type="button" data-tag={tag} aria-pressed="false">
						<span aria-hidden="true">#</span>{tag}
					</button>
				))}
			</div>
		)}
		<p class="visually-hidden" role="status" data-filter-status></p>
		<PostList {posts} />
	</section>
</SiteLayout>

<script>
	const archive = document.querySelector('[data-post-archive]');
	const filter = archive?.querySelector<HTMLElement>('.tag-filter');
	const status = archive?.querySelector('[data-filter-status]');

	if (archive && filter && status) {
		const posts = Array.from(archive.querySelectorAll<HTMLElement>('[data-post-tags]'), (row) => ({
			row,
			tags: JSON.parse(row.dataset.postTags ?? '[]') as string[],
		}));

		const buttons = filter.querySelectorAll<HTMLButtonElement>('button[data-tag]');

		function updateFilter(tag: string) {
			for (const button of buttons) {
				button.setAttribute('aria-pressed', String(button.dataset.tag === tag));
			}
			let count = 0;
			for (const { row, tags } of posts) {
				const visible = !tag || tags.includes(tag);
				row.hidden = !visible;
				if (visible) count++;
			}
			if (status) status.textContent = `${count}개 글`;
		}

		for (const button of buttons) {
			button.addEventListener('click', () => updateFilter(button.dataset.tag ?? ''));
		}
		filter.hidden = false;
	}
</script>
