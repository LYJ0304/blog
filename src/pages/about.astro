---
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import SiteLayout from '../layouts/SiteLayout.astro';
---

<SiteLayout title={`소개 · ${SITE_TITLE}`} description={SITE_DESCRIPTION}>
	<div class="page-heading">
		<h1>소개</h1>
		<p>{SITE_DESCRIPTION}</p>
	</div>
	<div class="prose about-content">
		<h2>프로젝트</h2>
		<ul>
			<li><a href="https://github.com/LYJ0304/blog">기술 블로그</a> · Astro와 Markdown으로 운영하는 개인 블로그</li>
		</ul>
		<p><a href="https://github.com/LYJ0304">GitHub 프로필</a></p>
	</div>
</SiteLayout>
