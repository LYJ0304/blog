---
import { sitePath } from '../paths';
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'a'>;

const { href, class: className, ...props } = Astro.props;
const internal = href?.startsWith('/') && !href.startsWith('//');
const url = internal ? sitePath(href) : href;
const isActive = internal && url && (href === '/'
	? Astro.url.pathname === url
	: Astro.url.pathname.startsWith(url));
---

<a href={url} aria-current={url === Astro.url.pathname ? "page" : undefined} class:list={[className, { active: isActive }]} {...props}>
	<slot />
</a>
